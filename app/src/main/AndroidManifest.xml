<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".QueueUpApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.QueueUp">

        <!-- CleverTap Project Credentials & Configuration -->
        <meta-data
            android:name="CLEVERTAP_ACCOUNT_ID"
            android:value="587-878-Z97Z" />
        <meta-data
            android:name="CLEVERTAP_TOKEN"
            android:value="bab-ab5" />
        <meta-data
            android:name="CLEVERTAP_REGION"
            android:value="eu1" />
        <meta-data
            android:name="CLEVERTAP_IDENTIFIER"
            android:value="Identity,Email,Phone" />
        <meta-data
            android:name="CLEVERTAP_USE_GOOGLE_AD_ID"
            android:value="0" />
        <!-- FCM Sender ID for push notification routing (Sender ID / Project Number from google-services.json) -->
        <meta-data
            android:name="FCM_SENDER_ID"
            android:value="id:86584646518" />
        <!-- Notification small icon in status bar (alpha-only) -->
        <meta-data
            android:name="CLEVERTAP_NOTIFICATION_ICON"
            android:value="ic_stat_notification" />
        <!-- Background sync support for pull notifications -->
        <meta-data
            android:name="CLEVERTAP_BACKGROUND_SYNC"
            android:value="1" />

        <!-- Firebase Cloud Messaging listener service for push messages and push templates -->
        <service
            android:name=".clevertap.QueueUpFcmMessageService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- CleverTap push click & impression tracking receiver -->
        <receiver
            android:name="com.clevertap.android.sdk.pushnotification.CTPushNotificationReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- R8 / ProGuard safeguard for legacy background job service -->
        <service
            android:name="com.clevertap.android.sdk.pushnotification.amp.CTBackgroundJobService"
            android:exported="false"
            android:enabled="false"
            tools:ignore="MissingClass" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QueueUp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
